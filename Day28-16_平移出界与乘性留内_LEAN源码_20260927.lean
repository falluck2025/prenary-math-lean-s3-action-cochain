import Mathlib

/-! ================================================================
   偏元数学 · Day28-16 · 四类变化的对照 · 平移出界 与 乘性留内
   ------------------------------------------------------------------
   核心：复数域上的"变化"分三类（平移 · 旋转 · 缩放）。本件落定一个
         结构差别：平移是加性的，它可以把 ℂ★ 里的点送到 0（出界）；
         而旋转与缩放都是乘性的（w * z），乘法保持"非零"且可逆 ——
         故后者是 ℂ★ 上的群运算，前者不是。
         这解释了为何"残差层 ε ∈ ℂ★"与"平移"不是同一类结构。
   本稿范围：三定理
     定理1  prenary_translation_leaves_star : a ≠ 0 ⟹ ∃z≠0, z + a = 0
     定理2  prenary_mul_stays_star          : w≠0 ∧ z≠0 ⟹ w*z ≠ 0
     定理3  prenary_mul_invertible          : w ≠ 0 ⟹ ∃μ, μ*w = 1
   不做：不主张"平移与缩放在物理上不同"；不涉及 π₁ 或绕数；
         不主张这三类穷尽一切变化。
   注：本件自带所需引理，独立可提交。上承 Day28-13/15（乘法侧的分离性）。
   日期：2026-09-27
   纪律：逐字提交 —— 抬头是提交原文的一部分，改动即改 SHA256。
   ================================================================ -/

namespace PrenaryDay28O

/-- 定理1（平移出界）：非零平移可把 ℂ★ 中的点送到 0 —— 平移不保持 ℂ★ -/
theorem prenary_translation_leaves_star (a : ℂ) (ha : a ≠ 0) :
    ∃ z : ℂ, z ≠ 0 ∧ z + a = 0 := by
  refine ⟨-a, neg_ne_zero.mpr ha, ?_⟩
  ring

/-- 定理2（乘性留内）：非零复数之积非零 —— 旋转与缩放都保持 ℂ★ -/
theorem prenary_mul_stays_star (w z : ℂ) (hw : w ≠ 0) (hz : z ≠ 0) :
    w * z ≠ 0 :=
  mul_ne_zero hw hz

/-- 定理3（乘性可逆）：非零复数皆可逆 —— 乘法是 ℂ★ 上的群运算 -/
theorem prenary_mul_invertible (w : ℂ) (hw : w ≠ 0) :
    ∃ μ : ℂ, μ * w = 1 :=
  ⟨w⁻¹, inv_mul_cancel₀ hw⟩

end PrenaryDay28O
